# RONA — contoh environment variables. Salin ke .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.
# File ini TIDAK boleh berisi nilai asli.

# URL publik aplikasi (tanpa slash akhir). Lokal: http://localhost:3000. Produksi: WAJIB diisi (mis. https://nama.vercel.app, lalu domain final bila sudah ada).
# Dipakai untuk canonical/Open Graph, tautan email Auth (konfirmasi, ganti email, atur ulang kata sandi), dan salin/buka URL.
# Tanpa nilai valid di produksi: canonical menjadi relatif dan tautan email Auth tidak membawa redirect (tidak ada fallback ke header Host).
# Wajib sama dengan salah satu Redirect URLs di Supabase (…/auth/callback). Pastikan terisi di Production DAN Preview Vercel.
NEXT_PUBLIC_SITE_URL=

# Supabase — Project Settings > API. Dua nilai berikut AMAN untuk browser (dilindungi RLS).
# KEPUTUSAN PENAMAAN (berlaku di seluruh aplikasi): kunci yang diberikan berformat JWT "anon" (eyJ...),
# jadi variabelnya NEXT_PUBLIC_SUPABASE_ANON_KEY. Jika kelak memakai kunci baru berformat "sb_publishable_...",
# isi nilai barunya ke variabel YANG SAMA; jangan menambah nama variabel kedua.
# Nama yang sama dipakai persis di .env.local dan di Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TIDAK dipakai di Phase 0 dan sebaiknya tidak pernah dibutuhkan: arsitektur memakai sesi pengguna + RLS.
# Jika kelak ada pekerjaan server yang benar-benar membutuhkannya, simpan HANYA sebagai variabel server
# (tanpa awalan NEXT_PUBLIC_), jangan diimpor dari komponen klien.
# SUPABASE_SERVICE_ROLE_KEY=
